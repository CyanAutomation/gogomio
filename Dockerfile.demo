# syntax=docker/dockerfile:1.7
# Generic amd64/arm64 image for the mock-camera demo and API development.
# Hardware camera dependencies belong only in the Pi-specific Dockerfile.

FROM node:22-alpine AS web
WORKDIR /src
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build:web && npm run check:web

FROM golang:1.27.3-alpine3.23 AS build
WORKDIR /src
COPY go.mod ./
RUN go mod download
COPY . .
COPY --from=web /src/internal/web/index.html ./internal/web/index.html
COPY --from=web /src/internal/web/generated/app.js ./internal/web/generated/app.js
RUN --mount=type=cache,target=/root/.cache/go-build,sharing=locked \
    CGO_ENABLED=0 /usr/local/go/bin/go build -trimpath -ldflags="-s -w" -o /out/gogomio ./cmd/gogomio

FROM alpine:3.22
RUN addgroup -S gogomio && adduser -S -G gogomio gogomio
COPY --from=build /out/gogomio /app/gogomio
USER gogomio
ENV PORT=8000
EXPOSE 8000
ENTRYPOINT ["/app/gogomio"]
