# GoGoMio environment configuration example.
# Copy to .env and customize values:
#   cp .env.example .env

# Camera mode toggle for local/dev usage (MOCK_CAMERA=true skips hardware camera access).
MOCK_CAMERA=false # accepted: true|false|1|0

# Optional directory of ordered .jpg/.jpeg fixtures for mock mode. Frames must
# match MIO_RESOLUTION; they are replayed at MIO_FPS and encoded at configured quality.
# MIO_MOCK_FRAME_DIR=./camera-frames

# Capture resolution in WIDTHxHEIGHT format.
MIO_RESOLUTION=640x480 # format: <positive-int>x<positive-int> (example: 1280x720)

# Camera capture frame rate.
MIO_FPS=24 # range: integer 1-120

# Internal target processing frame rate; defaults to MIO_FPS when unset.
MIO_TARGET_FPS=24 # range: integer 1-120

# JPEG encoder quality.
MIO_JPEG_QUALITY=90 # range: 1-100 (higher = better quality, larger frames)

# Maximum number of concurrent MJPEG streaming clients.
MIO_MAX_STREAM_CONNECTIONS=2 # range: integer 1-100

# App bind address and port (used by local runs and container server internals).
MIO_BIND_HOST=0.0.0.0 # accepted: IPv4/IPv6/hostname
MIO_PORT=8000 # range: 1-65535

# Host port published by docker-compose (maps host->container port).
GOGOMIO_PORT=8000 # range: 1-65535; keep equal to MIO_PORT for 1:1 mapping

# Optional timezone for container logs/runtime behavior.
TZ=UTC # accepted: IANA timezone (example: UTC, America/Los_Angeles)

# Optional trusted reverse proxy CIDRs, comma-separated. Leave unset unless
# requests arrive through a proxy whose client-IP and HTTPS scheme headers you
# trust. Configure the proxy to overwrite X-Forwarded-Proto and safely set or
# append X-Forwarded-For.
# MIO_TRUSTED_PROXY_CIDRS=

# Optional exact browser origins that may call the API cross-origin. GoGoMio
# does not allow cross-origin browser requests when this is unset; wildcards
# are rejected. Example: https://dashboard.example.com
# MIO_CORS_ALLOWED_ORIGINS=

# Optional username used by docker-compose.auth.yml (defaults to operator).
# Keep the password in ~/containers/gogomio/mio_password, not in this file.
# MIO_AUTH_USERNAME=operator

# Optional Go profiling listener on port 6060. Keep this disabled unless access
# is needed. When enabled, it listens on loopback only.
# MIO_ENABLE_PPROF=false
